modules = ["php-8.2", "web", "nodejs-18"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["nodejs_20", "yarn", "php82", "php82Packages.composer"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pterodactyl-panel"

[[workflows.workflow]]
name = "pterodactyl-panel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 36535
externalPort = 3000
